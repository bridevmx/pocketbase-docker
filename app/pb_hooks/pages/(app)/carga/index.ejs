<script server>
  const L = resolve('lib')
  const dias = Math.max(1, Math.min(31, parseInt(params.dias, 10) || 7))
  let carga = null
  let error = ''
  try {
    carga = L.consultaCarga(pb({ request }), Date.now(), dias)
  } catch (e) {
    error = L.mensajeError(e)
  }
</script>
<h1>Lista de carga</h1>
<form method="get" class="filtro">
  <label>Próximos
    <select name="dias" onchange="this.form.submit()">
      <% [1, 3, 7, 14, 31].forEach(n => { %><option value="<%= n %>"<%= n === dias ? ' selected' : '' %>><%= n %> día<%= n === 1 ? '' : 's' %></option><% }) %>
    </select>
  </label>
  <span id="conexion" class="conexion" data-estado="fuera">sin tiempo real</span>
  <span id="progreso" class="progreso"></span>
</form>
<% if (error) { %><p class="error"><%= error %></p><% } else { %>
<div id="carga" data-url="/xapi/carga?dias=<%= dias %>" data-clave="<%= carga.desdeF %>_<%= dias %>">
  <%- include('carga-lista.ejs', { carga, dias }) %>
</div>
<% } %>
<script type="module" src="/assets/carga.js"></script>
