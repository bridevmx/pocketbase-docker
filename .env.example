# =====================================================================================================================
# Variables de entorno del proyecto. Copia este archivo a `.env` (ya está en .gitignore: NUNCA lo subas) y rellena lo que uses.
# Lo lee examples/pbmini/lab/real.py (pruebas reales). PocketBase NO lee .env por sí solo: en producción define estas
# variables en tu servidor/Docker/Coolify. Vacío = apagado o valor por defecto.
# =====================================================================================================================

# ---- PocketBase (entorno de pruebas reales; datos aislados en examples/pbmini/lab/.run/real, nunca tocan tu base real) ----
PB_HTTP=127.0.0.1:8095                  # dirección local donde escucha el servidor de pruebas
PB_SUPERUSER_EMAIL=admin@real.test      # superusuario SOLO del entorno de pruebas
PB_SUPERUSER_PASSWORD=                  # mínimo 10 caracteres (el servidor de pruebas lo crea con `superuser upsert`)

# ---- pbmini (opcionales) ----
PBMINI_ON_ERROR=                        # "warn" = solo avisa si un módulo falla al registrarse (por defecto aborta el arranque)
PBMINI_PUBLIC_AUDIT=                    # strict (defecto) | warn | off
PBMINI_DEBUG=1                          # 1 = imprime los errores de handlers por consola (solo desarrollo)
PBMINI_STORE_MAX=                       # máximo de entradas de la caché de servidor
PBMINI_PUBLIC_DIR=                      # directorio público si no usas --publicDir
PBMINI_DEFAULT_LOCALE=                  # idioma por defecto si no hay Accept-Language

# ---- Telegram (módulo `telegram` de pbmini) ----
TELEGRAM_BOT_TOKEN=                     # de @BotFather: 123456789:AA...  (NUNCA lo pegues en chats ni commits)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=                   # base HTTPS pública (443/80/88/8443) donde Telegram llamará: https://tudominio.com  (sin ruta)
TELEGRAM_BOT_USERNAME=                  # sin @; si se deja vacío se obtiene con getMe
TELEGRAM_MINIAPP_URL=                   # URL https de tu Mini App (botones webApp y login)
TELEGRAM_OPERATOR_CHATS=                # ids de chat de operadores separados por comas (tu id personal: @userinfobot; grupos: negativos)
TELEGRAM_API_URL=                       # vacío = https://api.telegram.org (solo el laboratorio lo cambia)
TELEGRAM_TEST_CHAT=                     # chat donde `real.py --check` envía el mensaje de prueba (por defecto, el primero de OPERATOR_CHATS)

# ---- Correo (la configuración SMTP vive en Ajustes de PocketBase; real.py la aplica al servidor de pruebas) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_SENDER=                            # remitente (Ajustes > Correo)
MAIL_TEST_TO=                           # destinatario de la prueba real de correo

# ---- ntfy (en pausa; el plugin aún no existe) y el puente ntfy-bridge ----
NTFY_URL=                               # https://ntfy.tudominio.com
NTFY_TOKEN=                             # token tk_... del usuario `sender`
NTFY_BRIDGE_URL=
NTFY_BRIDGE_KEY=
NTFY_PUBLIC_URL=
NTFY_TOPIC_PREFIX=                      # prefijo de los tópicos (p. ej. conex); aún sin uso
BRIDGE_KEY=                             # ntfy-bridge: mínimo 32 caracteres
NTFY_BIN=ntfy
PORT=3000                               # puerto de ntfy-bridge

# ---- Clip (módulo `clip` de pbmini: pagos con links de pago) ----
# CLIP_API_TOKEN = "Basic " + base64(API_KEY:CLAVE_SECRETA), TAL CUAL (genéralo con el generador de https://developer.clip.mx/reference/token-de-autenticacion
# o con `echo -n API_KEY:SECRET | base64`). PocketBase no trae base64, por eso el plugin usa solo el token ya generado. NUNCA lo pegues en chats ni commits.
CLIP_API_TOKEN=                         # Basic <base64>   (Panel de Desarrollador de Clip; para pruebas usa una credencial "de prueba")
CLIP_API_URL=                           # vacío = https://api.payclip.com
CLIP_WEBHOOK_TOKEN=
CLIP_PUBLIC_URL=                        # URL https pública del servidor (cloudflared); `real.py clip serve` la escribe sola al arrancar el túnel
CLIP_TEST_AMOUNT=1                      # pesos de la prueba real (mínimo 1)
